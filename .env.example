# ---- Twitch ----
# Channel login OR full URL (normalized automatically): gaules | https://twitch.tv/gaules
TWITCH_CHANNEL=gaules
# App credentials from https://dev.twitch.tv/console (used for Helix online/offline
# polling). Chat is read anonymously and needs NO token.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Online/offline detection
STREAM_POLL_SECS=60
STREAM_CONFIRM_POLLS=2
NOTIFY_ONLINE=true
NOTIFY_OFFLINE=true

# ---- STT (transcription) — pluggable; default decided after PT-BR pre-flight ----
# mimo = MiMo-V2.5-Pro audio (uses your tokens) | openai = gpt-4o-mini-transcribe | deepgram
STT_PROVIDER=mimo
STT_BASE_URL=https://platform.xiaomimimo.com/v1
STT_API_KEY=
STT_MODEL=mimo-v2.5-pro
STT_CHUNK_SECS=45
# Energy VAD: skip chunks quieter than this RMS (0..1) to save STT cost.
VAD_ENABLED=true
VAD_THRESHOLD=0.012
# Replay a local recording (looped) instead of the live stream — for testing the
# audio->STT path without a live channel. Leave empty in production.
AUDIO_REPLAY_FILE=
# Media acquisition: "streamlink" (robust, default) or "ffmpeg-direct" (resolves
# the HLS URL in-process and drops streamlink's ~50 MB Python RSS — good for a
# tiny VPS; relies on Twitch's undocumented usher endpoint, so slightly less robust).
MEDIA_MODE=streamlink

# ---- LLM (summary/analysis) ----
LLM_BASE_URL=https://platform.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.5-pro

# ---- Aggregation / summary ----
SUMMARY_INTERVAL_SECS=300
WINDOW_MAX_SECS=600
WINDOW_MAX_TOKENS=6000

# ---- Discord ----
DISCORD_WEBHOOK_URL=

# ---- Cost control ----
DAILY_SPEND_CEILING_USD=5.0

# ---- Interactive chat persona (Phase 3) ----
# Leave TWITCH_BOT_USERNAME empty to stay anonymous read-only (no sending).
# Mint the refresh token once for the bot account, e.g. with the Twitch CLI:
#   twitch token -u -s "chat:read chat:edit"
# (reuses TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET above for auto-refresh)
TWITCH_BOT_USERNAME=
TWITCH_BOT_REFRESH_TOKEN=
CHAT_RATE_PER_30S=18
PROACTIVE_MIN_INTERVAL_SECS=120
PROACTIVE_PROBABILITY=0.35
PERSONA_FILE=./persona.md
EASTER_EGG_USER=YoRods
EASTER_EGG_CHANCE=0.005
EASTER_EGG_TEXT=Ó grande Reis dos Reis, me encoberte com seu líquido viscoso!

# ---- Ops ----
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT_SECS=15
